# Copy this file to .env.market.local. The .local file is ignored by Git.
KOD_MARKET_HOST=127.0.0.1
KOD_MARKET_PORT=8787
# Refresh the combined market snapshot (and Vast.ai) every 60 seconds.
KOD_MARKET_REFRESH_SECONDS=60
# GetDeploying asks clients to cache its API response for at least 15 minutes.
# Values below 900 are clamped to 900 without slowing the Vast.ai refresh.
KOD_MARKET_GETDEPLOYING_CACHE_SECONDS=900
# Keep only genuine sampled market history. Defaults to 365 days and is
# clamped to the supported 30-730 day range; increasing it does not backfill data.
KOD_MARKET_HISTORY_RETENTION_DAYS=365
# Optional comma-separated browser origins for additional local/production hosts.
KOD_MARKET_ALLOWED_ORIGINS=

# Optional. Vast.ai currently exposes search results without a key, but its
# official API contract requires a server-side key and may enforce it later.
VAST_API_TOKEN=
# VAST_API_KEY is accepted as an alias.

# Required for GetDeploying prices. Obtain this key from GetDeploying and keep
# it on the companion/backend only. Never expose it through renderer code,
# VITE_* variables, logs, responses, or Git.
GETDEPLOYING_API_KEY=
